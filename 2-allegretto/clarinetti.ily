\version "2.26.0"

clarinetti_satz_ii = \relative c'' {
	\clef treble
	\key a \minor
	\time 2/4

	<< g2~\f\> c~ >> | << g~ c~ >> | << g4\pp c >> r4 | r2 |
	r2               | r           | r                | r  |
	r2               | r           |

	r2 | r | r | r | r | r | r | r |
	r2 | r | r | r | r | r | r | r |
	r2 | r | r | r | r | r | r | r |
	r2 | r | r | r | r | r | r | r |
	r2 | r | r | r | r | r | r | r |
	r2 | r | r | r | r | r | r | r |
	r2 | r | r | r | r | r | r | r |
	r2 | r | r | r | r | r | r | r |

	<< g4\ff g' >> << g,8 g'-. >> << g, g'-. >> |
	<< g,4 g'-.( >> << g, g'-.) >> |
	<< g,4 g' >> << g,8 g'-. >> << g, g'-. >> |
	<< g,4 g'-.( >> << g, g'-.) >> |
	<< g,4 g' >> << g,8 g'-. >> << a, a'-. >> |
	<< bes,4 bes'-. >> << bes, bes'-. >>  |
	<< bes,4 bes' >> << bes,8 bes' >> << bes, bes' >> |
	<< bes,4 bes' >> r |
}
