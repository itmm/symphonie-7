\version "2.26.0"

clarini_satz_ii = \relative c'' {
	\clef treble
	\key a \minor
	\time 2/4

	r2 | r | r | r | r | r | r | r | r | r |
	r2 | r | r | r | r | r | r | r |
	r2 | r | r | r | r | r | r | r |
	r2 | r | r | r | r | r | r | r |
	r2 | r | r | r | r | r | r | r |
	r2 | r | r | r | r | r | r | r |
	r2 | r | r | r | r | r | r | r |
	r2 | r | r | r | r | r | r | r |
	r2 | r | r | r | r | r | r | r |

	<< a,4\ff a' >> r | e' r | e r | << a,, a' >> r |
	<< a, a' >> r     | r e' | r2  | e4 r           |

	e4 r          | r2              | e4 r     | << a,, a' >> r  |
	<< a, a' >> r | fis' << a,, a' >> | e'4 e8 e | << a,,4 a' >> r |  
}
