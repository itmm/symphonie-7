\version "2.26.0"

corni_satz_ii = \relative c' {
	\clef treble
	\key a \minor
	\time 2/4

	<< c2~\f\> c'~ >> | << c,~ c'~ >> | << c,4\pp c' >> r | r2 |
	r2                | r             | r                 | r  |
	r2                | r             |

	r2 | r | r | r | r | r | r | r |
	r2 | r | r | r | r | r | r | r |
	r2 | r | r | r | r | r | r | r |
	r2 | r | r | r | r | r | r | r |
}
