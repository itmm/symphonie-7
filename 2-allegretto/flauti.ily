\version "2.26.0"

flauti_satz_ii = \relative c'' {
	\clef treble
	\key a \minor
	\time 2/4

	R2*72 
% 73
	r4 gis' | r a |
% 75
	<< e4\ff e' >> << e,8 e'-. >> << e, e'-. >> |
	<< e,4 e'-.( >> << e, e'-.) >>              |
	<< e,4 e' >> << e,8 e'-. >> << e, e'-. >>   |
	<< e,4 e'-.( >> << e, e'-.) >>              |
% 79
	<< e,4 e' >> << e,8 e'-. >> << fis, fis'-. >> |
	<< g,4 g'-.( >> << g, g'-.) >>                |
	<< g,4 g' >> << g,8 g' >> << g, g' >>         |
	<< g,4 g' >> r                                |
% 83
	g,4 g8-. a-.                                          |
	b4-.( b-.)                                            |
	<< fis fis' >> << fis,8 fis'-. >> << gis,-. gis'-. >> |
	<< a,4 a'-.( >> << a, a'-.) >>                        |
% 87
	<< e, e' >> << e,8 e'-. >> << e,-. e'-. >>         |
	<< e,4 e'-.( >> << e, e'-.) >>                     |
	<< e, e' >> << fis,8 fis'-. >> << gis,-. gis'-. >> |
	<< a,4 a' >> r                                     |
% 91
}
