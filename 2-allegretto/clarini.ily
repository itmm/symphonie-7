\version "2.26.0"

clarini_satz_ii = \relative c'' {
	\clef treble
	\key a \minor
	\time 2/4

	R2*74
% 75
	<< a,4\ff a' >> r | e' r | e r | << a,, a' >> r |
	<< a, a' >> r     | r e' | r2  | e4 r           |
% 83
	e4 r          | r2                | e4 r     | << a,, a' >> r  |
	<< a, a' >> r | fis' << a,, a' >> | e'4 e8 e | << a,,4 a' >> r |  
% 91
}
